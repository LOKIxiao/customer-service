LLM_ENABLED=false
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# qwen3-rerank uses a workspace-specific full /reranks endpoint.
RERANK_ENABLED=false
RERANK_API_KEY=
RERANK_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RERANK_MODEL=qwen3-rerank
RERANK_CANDIDATE_K=20
RERANK_TIMEOUT_SECONDS=30

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
SESSION_MAX_MESSAGES=10
SESSION_TTL_SECONDS=86400
REDIS_SESSION_KEY_PREFIX=chat:session
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

RAG_EVIDENCE_GATE_ENABLED=true
RAG_VECTOR_THRESHOLD=0.75
RAG_BM25_THRESHOLD=9.0
RAG_LEXICAL_COVERAGE_THRESHOLD=0.3
RAG_LEXICAL_BM25_THRESHOLD=0.1
RAG_STRONG_BM25_THRESHOLD=12.0
